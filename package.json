{
	"name": "rhenium",
	"version": "0.0.0",
	"description": "Monorepo for the next iteration of Rhenium.",
	"homepage": "https://github.com/Rhenium-Labs/core#readme",
	"bugs": {
		"url": "https://github.com/Rhenium-Labs/core/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Rhenium-Labs/core.git"
	},
	"packageManager": "bun@1.3.10",
	"workspaces": [
		"deps/*",
		"apps/*"
	],
	"scripts": {
		"lint": "turbo run lint",
		"start": "turbo run start",
		"format": "turbo run format",
		"compile": "turbo run compile",
		"db:generate": "bunx prisma generate --schema ./deps/database/prisma/schema.prisma",
		"bot:start": "bun run start --filter @rhenium/bot"
	},
	"devDependencies": {
		"@types/node": "^25.4.0",
		"oxlint": "^1.53.0",
		"prettier": "^3.8.1",
		"turbo": "^2.8.16",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"dotenv": "^17.3.1",
		"kysely": "^0.28.11",
		"kysely-postgres-js": "^3.0.0",
		"postgres": "^3.4.8",
		"prisma": "^7.5.0",
		"prisma-kysely": "^3.1.0"
	}
}
