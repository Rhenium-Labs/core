generator kysely {
    provider           = "prisma-kysely"
    output             = "../src/"
    fileName           = "Schema.ts"
    enumFileName       = "Enums.ts"
    importExtension    = ".js"
    exportWrappedTypes = true
}

datasource db {
    provider = "postgresql"
}

enum InfractionAction {
    Warn
    Mute
    Kick
    Ban
    Unmute
    Unban
}

enum InfractionFlag {
    // The infraction was created automatically from a certain action.
    Automatic
    // The infraction was created from a native moderation action through Discord's audit log.
    Native
}

enum RequestStatus {
    AutoApproved
    Disregarded
    Approved
    Pending
    Denied
}

enum ReportStatus {
    AutoResolved
    Disregarded
    Resolved
    Pending
}

model Config {
    // The guild ID.
    id   String @id
    // Arbitrary JSON data for the guild's configuration. This is validated and parsed at the application level through Zod, so the database has no knowledge of the actual structure of this data.
    data Json
}

// This table contains the responses rhenium will send for a specific action.
// Messages marked with "NOT_EDITABLE" cannot be edited in the dashboard, and are only used for internal purposes.
model DefaultMessage {
    // The guild ID.
    id String @id

    // NOT_EDITABLE
    ping_success Json
}

model Infraction {
    id                String    @id
    guild_id          String
    target_id         String
    executor_id       String
    created_at        DateTime  @default(now())
    expires_at        DateTime?
    // These indicate the infraction was created from a ban request.
    request_id        String?
    request_author_id String?

    action InfractionAction @default(Warn)
    reason String?
}

model BanRequest {
    id                 String  @id
    guild_id           String
    target_id          String
    infraction_id      String? // The infraction created from this ban request, if applicable.
    mute_infraction_id String? // The infraction ID of the mute created from this ban request, if applicable.

    status RequestStatus @default(Pending)

    resolved_at DateTime?
    resolved_by String?

    requested_at DateTime @default(now())
    requested_by String

    expires_at DateTime?
    reason     String
}

model MessageReport {
    id            String  @id
    guild_id      String
    message_id    String
    reference_id  String?
    infraction_id String? // The infraction created from this report, if applicable.
    message_url   String
    channel_id    String
    author_id     String
    content       String?

    reported_at          DateTime
    reported_by          String
    report_reason        String
    additional_reporters String[] @default([])

    status ReportStatus @default(Pending)

    resolved_at DateTime?
    resolved_by String?
}

model Highlight {
    user_id          String
    guild_id         String
    patterns         String[] @default([])
    user_blacklist   String[] @default([])
    include_channels String[] @default([])
    exclude_channels String[] @default([])

    // These are still enforced at the database level.
    // Kysely just has no idea about them because it's not an ORM.
    @@id([user_id, guild_id])
}

model QuickMute {
    user_id  String
    guild_id String
    reaction String

    duration     BigInt
    reason       String
    purge_amount Int    @default(0)

    // Just like the Highlight model, this is still enforced at the database level.
    @@id([user_id, guild_id, reaction])
}

model QuickPurge {
    user_id      String
    guild_id     String
    reaction     String
    purge_amount Int

    // Just like the Highlight model, this is still enforced at the database level.
    @@id([user_id, guild_id, reaction])
}
