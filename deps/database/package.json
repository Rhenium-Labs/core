{
	"name": "@deps/db",
	"type": "module",
	"main": "./build/index.js",
	"private": true,
	"exports": {
		"./enums": {
			"types": "./src/Enums.ts",
			"default": "./build/Enums.js"
		},
		"./schema": {
			"types": "./src/Schema.ts",
			"default": "./build/Schema.js"
		},
		".": {
			"types": "./src/index.ts",
			"default": "./build/index.js"
		}
	},
	"scripts": {
		"lint": "oxlint src/**/*.ts -c ../../.oxlintrc.json",
		"format": "prettier --write src/**/*.ts",
		"compile": "tsc",
		"db:migrate": "bunx prisma migrate deploy",
		"db:generate": "bunx prisma generate"
	}
}
