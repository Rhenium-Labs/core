{
	"name": "@rhenium/bot",
	"type": "module",
	"main": "./build/index.js",
	"version": "0.0.0",
	"description": "Source code for the next iteration of the Rhenium bot.",
	"homepage": "https://github.com/Rhenium-Labs/core/blob/main/apps/rhenium/README.md",
	"bugs": {
		"url": "https://github.com/Rhenium-Labs/core/issues"
	},
